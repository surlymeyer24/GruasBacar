VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# VAPID key para push notifications (Firebase Console > Project Settings > Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=

# true = login normal | false = sin pantalla de login (modo dev)
VITE_AUTH_ENABLED=true

# true = datos simulados en localStorage (sin Firebase Auth). Por defecto false.
VITE_IS_MOCK=false
VITE_DEV_EMAIL=chofer@bacar.com
VITE_DEV_PASSWORD=Chofer123!

# Solo con emuladores (VITE_USE_EMULATORS=true) y FOTOS_OPCIONALES_DEV=true en functions/.env
VITE_FOTOS_OPCIONALES=false

# true = Auth, Firestore, Storage y Functions apuntan a emuladores locales
# En `npm run dev` (modo development) esto queda en true vía `.env.development`.
VITE_USE_EMULATORS=false

# true = build del site de prueba (test-gruasbacar). Marca actas con esTest.
# No activar en el build de producción.
VITE_ES_TEST=false
