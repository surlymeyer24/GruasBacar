{
  "name": "gruasbacar",
  "private": true,
  "workspaces": [
    "shared",
    "functions",
    "frontend"
  ],
  "scripts": {
    "prebuild": "node scripts/ensure-deps.mjs",
    "dev": "cd frontend && npm run dev",
    "emu": "npm run build --workspace=@gruasbacar/shared && npm run build --workspace=gruasbacar-functions && firebase emulators:start --import=.emulator-data --export-on-exit=.emulator-data",
    "emu:seed": "node scripts/pull-prod.mjs",
    "build": "npm run build --workspace=@gruasbacar/shared && npm run build --workspace=gruasbacar-functions && npm run build --workspace=gruasbacar-frontend",
    "preflight": "node scripts/preflight.mjs",
    "backup": "node scripts/backup-firestore.mjs --prod",
    "import-drive-actas": "node scripts/importar-actas-desde-drive.mjs --prod",
    "ship": "node scripts/ship.mjs",
    "ship:hosting": "node scripts/ship.mjs --hosting",
    "ship:functions": "node scripts/ship.mjs --functions",
    "ship:rules": "node scripts/ship.mjs --rules",
    "ship:dry": "node scripts/ship.mjs --dry-run",
    "ship:test": "node scripts/ship-test.mjs",
    "deploy": "npm run build && firebase deploy",
    "deploy:functions": "node functions/scripts/predeploy.mjs && firebase deploy --only functions",
    "deploy:test": "node scripts/ship-test.mjs",
    "seed": "node scripts/pull-prod.mjs",
    "sync-usuarios": "node scripts/sync-usuarios.mjs --prod",
    "migrate-uids": "node scripts/migrar-uids-usuarios.mjs --prod",
    "migrate-gruas": "node scripts/migrar-ids-gruas.mjs --prod",
    "migrate-duplas": "node scripts/migrar-duplas-enganchador.mjs --prod",
    "pull-prod": "node scripts/pull-prod.mjs",
    "migrate-servicios": "node scripts/migrar-ids-servicios.mjs --prod",
    "emulators": "npm run build --workspace=@gruasbacar/shared && npm run build --workspace=gruasbacar-functions && firebase emulators:start --import=.emulator-data --export-on-exit=.emulator-data",
    "fix-invokers": "powershell -ExecutionPolicy Bypass -File scripts/fix-invokers.ps1"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  }
}
